{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sokunet-relay",
  "main": "src/index.js",
  "compatibility_date": "2026-11-23",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "SOKUNET_ROOM",
        "class_name": "SokuNetRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SokuNetRoom"]
    }
  ]
}
